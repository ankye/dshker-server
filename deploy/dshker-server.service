[Unit]
Description=DSHKer standalone pairing server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dshker-server
Group=dshker-server
ExecStart=/usr/local/bin/dshker-server serve --config /etc/dshker-server/config.json
WorkingDirectory=/var/lib/dshker-server
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dshker-server
PrivateTmp=true
# RestrictAddressFamilies is deliberately NOT set: the TURN relay allocates a
# UDP socket per allocation and its signalling path needs address families
# beyond AF_INET/AF_INET6, so the restriction makes the service fail to start
# with p2p.operation_failed. Keep the other hardening directives instead.

[Install]
WantedBy=multi-user.target
